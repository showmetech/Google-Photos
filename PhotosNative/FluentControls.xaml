<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="ControlFill" Color="#2D2D2D"/>
 <SolidColorBrush x:Key="ControlHoverFill" Color="#0FFFFFFF"/>
 <SolidColorBrush x:Key="ControlPressedFill" Color="#09000000"/>
 <SolidColorBrush x:Key="ControlDisabledFill" Color="#202020"/>
 <SolidColorBrush x:Key="ControlDisabledInk" Color="#9D9D9D"/>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
  <Setter Property="Padding" Value="12,5"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle"><Setter.Value><Style>
   <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border CornerRadius="6" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Margin="-3"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid SnapsToDevicePixels="True">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
     <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard></VisualState>
     <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard></VisualState>
     <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
     <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
    <Border x:Name="Hover" Background="{DynamicResource ControlHoverFill}" CornerRadius="4" Margin="1" Opacity="0" IsHitTestVisible="False"/>
    <Border x:Name="PressedLayer" Background="{DynamicResource ControlPressedFill}" CornerRadius="4" Margin="1" Opacity="0" IsHitTestVisible="False"/>
    <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource ControlDisabledFill}"/><Setter Property="Foreground" Value="{DynamicResource ControlDisabledInk}"/><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/><Setter TargetName="ButtonContent" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
